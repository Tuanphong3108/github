# URL công khai (https) của server sau khi deploy, KHÔNG có dấu / ở cuối
PUBLIC_URL=https://your-app.onrender.com

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Authorization callback URL = <PUBLIC_URL>/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cặp OAuth bạn sẽ điền vào Gemini (chạy: npm run gen-creds)
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Khoá mã hoá token/code (chạy: npm run gen-creds). Đổi giá trị này = mọi kết nối cũ phải đăng nhập lại.
SESSION_SECRET=

# Tuỳ chọn
# GITHUB_SCOPES=repo            # thêm "workflow" nếu cần sửa .github/workflows
# ALLOWED_REDIRECT_URIS=https://example.com/callback,https://other.com/   # để trống = chấp nhận mọi https redirect
# PORT=3000
